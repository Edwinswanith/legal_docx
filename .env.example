# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides — defaults are the floating -latest aliases so the
# pipeline doesn't need a code change when a pinned snapshot is retired.
# GEMINI_CLASSIFY_MODEL=gemini-flash-latest
# GEMINI_EXTRACT_MODEL=gemini-pro-latest

# Independent extraction runs per document, merged and cross-checked (1 disables; costs scale with this)
CONSENSUS_RUNS=2

# --- Login ---
# First admin, created on startup only if no admin exists yet. Change the
# password from the Users page afterwards; changing these values later has no effect.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long
# Signs session cookies. Required in production; any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Persistent user storage. Without it, users live in data/users.json, which
# a host with an ephemeral disk (Render free tier) wipes on every restart.
# A free Postgres (e.g. Neon) connection string works:
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
